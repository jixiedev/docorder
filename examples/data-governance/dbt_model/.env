# 算子 home 默认是本目录下的 .op_home，由 job.py 设置。
# 需要指向别处时，在这里写 DOCORDER_HOMES="/path/to/homes"。
#
# 大模型工具。这个作业默认用 MiniMax，改成 cursor 就切到脚本里配好的 cursor 预设。
# 命令行上的 DOCORDER_LLM 会覆盖这里。
DOCORDER_LLM=minimax

# MiniMax Code 客户端。工具脚本读这两个变量。
# 客户端不在默认位置（~/.minimax-code/bin/mcode）时，用 MCODE_BIN 指过去。
MCODE_MODEL=minimax/MiniMax-M3.1-Flash
MCODE_TIMEOUT=30m
